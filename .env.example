# ============================================================================
# TradeLedger — environment variables
# Copy to your host's env settings (Railway/Render/Fly) or a local .env
# ============================================================================

# --- Required in every mode ---------------------------------------------------
# PostgreSQL connection string. On Railway/Render this is provided by the
# managed Postgres add-on.
DATABASE_URL=postgres://user:password@host:5432/tradeledger

# Port the server listens on. Most hosts inject this automatically — leave unset
# on Railway/Render/Fly and they will set it for you. Defaults to 8080 locally.
# PORT=8080

NODE_ENV=production

# --- No-login / single-tenant mode -------------------------------------------
# Set to "true" to bypass OIDC entirely. Every request is treated as one fixed
# user (see LOCAL_USER_* below). No identity provider, no login screen.
# Leave unset / "false" to use the original OIDC login flow instead.
AUTH_DISABLED=true

# Optional overrides for the single fixed user used when AUTH_DISABLED=true.
# Defaults shown — fine to leave as-is for personal use.
# LOCAL_USER_ID=local-user
# LOCAL_USER_EMAIL=owner@example.com
# LOCAL_USER_FIRST_NAME=Local
# LOCAL_USER_LAST_NAME=User

# --- OIDC login mode (only needed when AUTH_DISABLED is NOT "true") -----------
# ISSUER_URL=https://accounts.google.com   # or https://replit.com/oidc
# REPL_ID=<oauth_client_id>                 # OAuth client_id for the issuer
# SESSION_SECRET=<random_string>

# --- Optional ---------------------------------------------------------------
# Webhook the API POSTs to when a new advisory request is created (fire-and-forget).
# ADVISORY_WEBHOOK_URL=
